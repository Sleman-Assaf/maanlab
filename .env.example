# Copy to .env and adjust. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS in production, e.g. https://maanlab.com,https://www.maanlab.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Canonical site URL used for SEO (canonical, hreflang, sitemap, Open Graph).
SITE_URL=http://127.0.0.1:8000

# --- Database -----------------------------------------------------------
# sqlite (default) or postgres
DB_ENGINE=sqlite
DB_NAME=maanlab
DB_USER=maanlab
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Contact ------------------------------------------------------------
CONTACT_EMAIL=hello@maanlab.com
# Optional: send a notification email for each new inquiry.
CONTACT_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=MAAN LAB <no-reply@maanlab.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Social (placeholders) ----------------------------------------------
SOCIAL_INSTAGRAM=https://instagram.com/
SOCIAL_FACEBOOK=https://facebook.com/
SOCIAL_LINKEDIN=https://linkedin.com/

# --- Production security (only used when DJANGO_DEBUG=False) -------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0
# Set to True when running behind a proxy that sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=False
